APP_ENV=development
APP_NAME=Student Council API

# Compose database credentials. Keep DATABASE_URL in sync if you change them.
POSTGRES_DB=student_council
POSTGRES_USER=student_council
POSTGRES_PASSWORD=student_council
DATABASE_URL=postgresql+asyncpg://student_council:student_council@db:5432/student_council

# Public development placeholders only. Replace before any deployment.
JWT_SECRET_KEY=development-only-replace-this-jwt-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# Optional bootstrap. Uncomment BOTH to create an initial administrator.
# FIRST_ADMIN_EMAIL=admin@example.com
# FIRST_ADMIN_PASSWORD=replace-with-a-unique-long-password
